---
// Base.astro — layout raíz del sitio 3.0 (perfil estilo Clearly).
// Head completo: meta, OG, canonical + hreflang he<->ru, favicon, preload de fuentes,
// metadatos sociales y un slot 'head' para JSON-LD por página.
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import {
  ANALYTICS_ENABLED,
  GOOGLE_ANALYTICS_ID,
  SITE_URL,
  PROFILE_IMAGE,
} from '../config/site';
import type { Locale } from '../i18n/types';

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  // Directiva robots. Default = paridad con producción (snippets/imágenes ricos).
  // Páginas legales/no indexables la sobreescriben con 'noindex,follow' para
  // emitir UNA sola <meta robots> (sin duplicados contradictorios).
  robots?: string;
  // Páginas que existen en un solo idioma (ej. /terms, solo hebreo) ponen esto en
  // false para NO emitir hreflang hacia un espejo /ru/... inexistente.
  alternates?: boolean;
  // Canonical explícito para rutas únicas cuyo idioma de contenido no coincide
  // con su prefijo URL (ej. /credentials con contenido ruso pero sin /ru/).
  canonicalPath?: string;
  // El perfil usa `profile`; páginas funcionales, legales y de error usan `website`.
  ogType?: 'profile' | 'website';
}

const {
  title,
  lang = 'he',
  description = '',
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  alternates = true,
  canonicalPath,
  ogType = 'profile',
} = Astro.props;
const dir = lang === 'he' ? 'rtl' : 'ltr';

// URLs canónicas y alternas he<->ru. Con build.format:'file' el pathname en build
// llega como '/ru.html', '/booking.html' o '/index.html'; hay que normalizarlo a la
// forma que sirve producción: raíces con barra final (/, /ru/), subpáginas SIN barra
// final (/terms, /booking) — igual que los canonical del htaccess de producción.
const rawPath = Astro.url.pathname;
const cleanPath = rawPath
  .replace(/index\.html$/, '') // /index.html -> / ; /ru/index.html -> /ru/
  .replace(/\.html$/, '') //     /ru.html -> /ru , /booking.html -> /booking
  .replace(/\/{2,}/g, '/'); // colapsa dobles barras
// basePath = ruta hebrea equivalente (sin el prefijo /ru); raíz = '/', resto sin barra final.
let basePath = cleanPath.replace(/^\/ru(?=\/|$)/, '') || '/';
if (basePath !== '/' && basePath.endsWith('/')) basePath = basePath.slice(0, -1);
const heHref = new URL(basePath, SITE_URL).href;
const ruHref = new URL(basePath === '/' ? '/ru/' : `/ru${basePath}`, SITE_URL).href;
const canonical = canonicalPath
  ? new URL(canonicalPath, SITE_URL).href
  : lang === 'he'
    ? heHref
    : ruHref;

// Preload del subset de Rubik del idioma actual + latín (siempre presente: dígitos/símbolos).
const localeFont = lang === 'he' ? '/assets/fonts/rubik-var-hebrew.woff2' : '/assets/fonts/rubik-var-cyrillic.woff2';

const ogImage = new URL(PROFILE_IMAGE, SITE_URL).href;

// Implementación de opt-in conservada detrás de ANALYTICS_ENABLED. Cuando está
// apagada no se genera markup, bootstrap ni loader; una aceptación anterior en
// localStorage no puede reactivar GA4 por sí sola.
const analyticsBootstrap = `(function(w,d){var key='dima_analytics_consent';var host=w.location.hostname.toLowerCase().replace(/^www\\./,'');var production=w.location.protocol==='https:'&&host==='dimatherapyonline.com';var loading=false;w.__dimaTrackingEnabled=false;function read(){try{return w.localStorage.getItem(key)||'';}catch(e){return '';}}function write(value){try{w.localStorage.setItem(key,value);}catch(e){}}function cleanUrl(value){try{var url=new URL(value,w.location.origin);return url.origin+url.pathname;}catch(e){return '';}}function enable(){if(!production||loading)return;loading=true;w.dataLayer=w.dataLayer||[];w.gtag=w.gtag||function(){w.dataLayer.push(arguments);};w.gtag('consent','default',{analytics_storage:'granted',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied'});w.gtag('js',new Date());w.gtag('config','${GOOGLE_ANALYTICS_ID}',{send_page_view:true,page_location:cleanUrl(w.location.href),page_referrer:cleanUrl(d.referrer),allow_google_signals:false,allow_ad_personalization_signals:false});w.__dimaTrackingEnabled=true;d.dispatchEvent(new CustomEvent('dima:analytics-ready'));var s=d.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ANALYTICS_ID}';d.head.appendChild(s);}function init(){var box=d.querySelector('[data-analytics-consent]');if(!production){if(box)box.hidden=true;return;}var choice=read();if(choice==='accepted'){if(box)box.hidden=true;enable();return;}if(choice==='declined'){if(box)box.hidden=true;return;}if(!box)return;box.hidden=false;var accept=box.querySelector('[data-analytics-accept]');var decline=box.querySelector('[data-analytics-decline]');if(accept)accept.addEventListener('click',function(){write('accepted');box.hidden=true;enable();});if(decline)decline.addEventListener('click',function(){write('declined');box.hidden=true;});}if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',init,{once:true});else init();})(window,document);`;
const analyticsConsent = lang === 'he'
  ? {
      ariaLabel: 'פרטיות ומדידה',
      title: 'פרטיות ומדידה',
      text: 'לאחר הסכמתך נשתמש ב-Google Analytics לסטטיסטיקה כללית של ביקורים ולחיצות. האתר ימשיך לפעול גם ללא אנליטיקה.',
      accept: 'אישור מדידה',
      decline: 'לא תודה',
      policy: 'מדיניות פרטיות',
    }
  : {
      ariaLabel: 'Конфиденциальность и аналитика',
      title: 'Конфиденциальность и аналитика',
      text: 'После вашего согласия мы используем Google Analytics для общей статистики посещений и нажатий. Сайт продолжит работать и без аналитики.',
      accept: 'Разрешить аналитику',
      decline: 'Нет, спасибо',
      policy: 'Политика конфиденциальности',
    };
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Google Analytics se carga una sola vez, únicamente en producción real y
      después del consentimiento. Las URLs enviadas excluyen query y fragmento.
    -->
    {ANALYTICS_ENABLED && <script is:inline set:html={analyticsBootstrap} />}

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- Señales de indexación: por defecto paridad con producción (snippets/imágenes
         ricos); las páginas legales pasan robots="noindex,follow" para no indexarse. -->
    <meta name="robots" content={robots} />
    <meta name="author" content="Dmitriy Kazakov" />
    <meta name="theme-color" content="#f7f4ef" />

    <link rel="canonical" href={canonical} />
    {alternates && <link rel="alternate" hreflang="he" href={heHref} />}
    {alternates && <link rel="alternate" hreflang="ru" href={ruHref} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={heHref} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Dima Therapy Online" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Dmitriy Kazakov" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'he' ? 'he_IL' : 'ru_RU'} />
    <meta property="og:locale:alternate" content={lang === 'he' ? 'ru_RU' : 'he_IL'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <!-- Iconos -->
    <link rel="icon" type="image/png" href="/assets/icons/favicon-d.png" />
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />

    <!-- Preload de fuentes: subset del locale actual + latín -->
    <link rel="preload" href={localeFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/rubik-var-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- JSON-LD u otras etiquetas por página -->
    <slot name="head" />
  </head>
  <body>
    <slot />

    {ANALYTICS_ENABLED && (
      <aside
        class="analytics-consent"
        data-analytics-consent
        role="region"
        aria-label={analyticsConsent.ariaLabel}
        hidden
      >
        <div class="analytics-consent-copy">
          <strong>{analyticsConsent.title}</strong>
          <p>{analyticsConsent.text}</p>
          <a href="/terms">{analyticsConsent.policy}</a>
        </div>
        <div class="analytics-consent-actions">
          <button type="button" class="analytics-consent-accept" data-analytics-accept>
            {analyticsConsent.accept}
          </button>
          <button type="button" class="analytics-consent-decline" data-analytics-decline>
            {analyticsConsent.decline}
          </button>
        </div>
      </aside>
    )}

    {ANALYTICS_ENABLED && (
      <script>
        import '../scripts/track';
      </script>
    )}
  </body>
</html>

<style>
  .analytics-consent {
    position: fixed;
    z-index: 1000;
    inset-inline: max(12px, env(safe-area-inset-left)) max(12px, env(safe-area-inset-right));
    inset-block-end: max(12px, env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    max-inline-size: 760px;
    margin-inline: auto;
    padding: var(--sp-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--r-card);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--sh-pop);
  }

  .analytics-consent[hidden] {
    display: none;
  }

  .analytics-consent-copy {
    flex: 1;
    min-inline-size: 0;
  }

  .analytics-consent-copy strong {
    display: block;
    margin-block-end: var(--sp-1);
  }

  .analytics-consent-copy p {
    margin: 0;
    color: var(--color-text-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  .analytics-consent-copy a {
    display: inline-block;
    margin-block-start: var(--sp-1);
    color: var(--color-primary-hover);
    font-size: var(--fs-xs);
  }

  .analytics-consent-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--sp-2);
  }

  .analytics-consent-actions button {
    min-block-size: 44px;
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-btn);
    font: inherit;
    font-weight: var(--fw-semibold);
    cursor: pointer;
  }

  .analytics-consent-accept {
    border: 1px solid var(--color-primary);
    background: var(--color-primary);
    color: var(--color-text-on-primary);
  }

  .analytics-consent-decline {
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .analytics-consent {
      align-items: stretch;
      flex-direction: column;
      gap: var(--sp-3);
    }

    .analytics-consent-actions,
    .analytics-consent-actions button {
      inline-size: 100%;
    }
  }
</style>
