---
// index.astro (ru) — página real de perfil en ruso. Ensambla vía ProfilePage;
// esta página solo aporta el layout Base (meta/head) y el JSON-LD Person+Offer.
// Cero copy hardcodeado: todo sale de getDict('ru') + helpers de config.
import Base from '../../layouts/Base.astro';
import ProfilePage from '../../components/ProfilePage.astro';
import { getDict } from '../../i18n';
import { buildPersonSchema } from '../../config/jsonld';

const t = getDict('ru');
const personSchema = buildPersonSchema(t, 'ru');
---

<Base title={t.meta.title} description={t.meta.description} lang="ru">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>
  <ProfilePage locale="ru" />
</Base>
