---
import Base from '../layouts/Base.astro';
import CredentialsPage from '../components/CredentialsPage.astro';
import { SITE_URL } from '../config/site';

const title = 'Дипломы и сертификаты | Дмитрий Казаков';
const description = 'Изображения документов о подготовке Дмитрия Казакова в области психосоматики и дополнительном профессиональном образовании.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: `${SITE_URL}/credentials`,
  description,
  inLanguage: ['ru', 'he'],
  about: {
    '@type': 'Person',
    name: 'Dmitriy Kazakov',
  },
};
---

<Base title={title} description={description} lang="ru" alternates={false} canonicalPath="/credentials" ogType="website">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <CredentialsPage />
</Base>
