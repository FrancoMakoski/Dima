---
// ProfileShell.astro — contenedor centrado del perfil (estilo Clearly).
// Layout de DOS REGIONES (igual que Clearly):
//   Región A (.shell-grid): 2 columnas [main | sidebar 340px]. La sidebar es
//     sticky y acompaña el scroll durante toda la región A.
//   Región B (.shell-wide): ancho completo del contenido (~1140px), debajo de
//     la región A. Aquí van schedule, reseñas, banner verificado, FAQ y footer.
// Móvil (<960px): 1 sola columna con ORDEN estilo Clearly (header → video →
//   about → qualifications → schedule → reviews → generalInfo → experience →
//   verified → faq → footer). Para lograrlo sin duplicar markup, los wrappers
//   intermedios (.shell-grid, .shell-main, .shell-sidebar*, .shell-wide) pasan a
//   display:contents y el propio .shell se vuelve un flex column; así todas las
//   secciones (envueltas en .pm-item por ProfilePage) se vuelven hermanas y se
//   ordenan con `order` (definido en ProfilePage). La StickyCard queda oculta.
// Slots nombrados: topbar, main, sidebar, wide, after.
// Solo propiedades lógicas → se espeja solo con dir="rtl".
---

<div class="shell">
  <div class="shell-topbar">
    <slot name="topbar" />
  </div>

  <div class="shell-grid">
    <aside class="shell-sidebar">
      <div class="shell-sidebar-inner">
        <slot name="sidebar" />
      </div>
    </aside>

    <main class="shell-main">
      <slot name="main" />
    </main>
  </div>

  <div class="shell-wide">
    <slot name="wide" />
  </div>

  <slot name="after" />
</div>

<style>
  .shell {
    max-inline-size: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--page-pad);
    padding-block-end: var(--sp-10);
  }

  .shell-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--sidebar-w);
    grid-template-areas: 'main sidebar';
    gap: var(--col-gap);
    /* SIN align-items:start: el aside debe estirarse a la altura de la fila para
       que su hijo sticky tenga recorrido durante toda la región A. */
  }

  .shell-main {
    grid-area: main;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .shell-sidebar {
    grid-area: sidebar;
    min-inline-size: 0;
    /* stretch por defecto (altura completa de la fila del grid) → da recorrido
       al sticky de .shell-sidebar-inner. */
  }

  .shell-sidebar-inner {
    position: sticky;
    top: var(--sticky-top);
  }

  /* Región B: ancho completo del contenido, apilada bajo la región A con el
     mismo ritmo vertical que las cards de la columna main. */
  .shell-wide {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    margin-block-start: var(--sp-6);
  }

  /* Móvil: una sola columna, orden Clearly. Los wrappers intermedios colapsan
     (display:contents) para que TODAS las secciones (.pm-item) se vuelvan
     hermanas dentro del flex column de .shell y se ordenen con `order`. */
  @media (max-width: 960px) {
    .shell {
      display: flex;
      flex-direction: column;
      gap: var(--sp-5);
    }

    /* El topbar debe quedar SIEMPRE primero, fuera del reordenado. */
    .shell-topbar {
      order: -1;
    }

    .shell-grid,
    .shell-main,
    .shell-sidebar,
    .shell-sidebar-inner,
    .shell-wide {
      display: contents;
    }
  }
</style>
