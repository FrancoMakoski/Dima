---
import CtaWhatsApp from './CtaWhatsApp.astro';

const copies = {
  ru: {
    lang: 'ru',
    dir: 'ltr',
    title: 'Дипломы и сертификаты | Дмитрий Казаков',
    homeHref: '/ru/',
    homeLabel: 'Вернуться на главную',
    eyebrow: 'Профессиональная подготовка',
    heading: 'Дипломы и сертификаты',
    lead: 'На этой странице представлены изображения документов о подготовке Дмитрия Казакова в области психосоматики и дополнительного профессионального образования.',
    documentsHeading: 'Представленные документы',
    documentsLead: 'Нажмите на изображение, чтобы открыть документ полностью и рассмотреть детали.',
    open: 'Открыть документ',
    cards: [
      {
        label: 'Сертификат',
        title: 'Национальная ассоциация специалистов по психосоматике',
        text: 'Сертификат №00113, представленный на сайте в виде изображения оригинального документа.',
        image: '/assets/img/certificate-psychosomatics-association.jpeg',
        alt: 'Сертификат Национальной ассоциации специалистов по психосоматике №00113',
      },
      {
        label: 'Повышение квалификации',
        title: 'Удостоверение о повышении квалификации, 120 часов',
        text: 'Международный институт практической психологии, Москва, 2018. Подготовка по работе с психосоматикой.',
        image: '/assets/img/certificate-practical-psychology-1600.webp',
        alt: 'Удостоверение о повышении квалификации на 120 часов, Москва, 2018',
      },
    ],
    nextHeading: 'Готовы выбрать время?',
    nextText: 'Первая онлайн-сессия стоит 197 ₪. Выберите время в календаре или задайте вопрос в WhatsApp.',
    booking: 'Выбрать время',
    whatsapp: 'Задать вопрос',
    waMessage: 'Здравствуйте, Дмитрий. У меня есть вопрос перед записью на сессию.',
  },
  he: {
    lang: 'he',
    dir: 'rtl',
    title: 'דיפלומות ותעודות מקצועיות | דמיטרי קזקוב',
    homeHref: '/',
    homeLabel: 'חזרה לעמוד הראשי',
    eyebrow: 'הכשרה מקצועית',
    heading: 'דיפלומות ותעודות מקצועיות',
    lead: 'בעמוד זה מוצגים צילומי מסמכים על הכשרתו של דמיטרי קזקוב בתחום הפסיכוסומטיקה ובהשתלמות מקצועית נוספת.',
    documentsHeading: 'המסמכים המוצגים',
    documentsLead: 'ניתן ללחוץ על התמונה כדי לפתוח את המסמך במלואו ולראות את הפרטים.',
    open: 'פתיחת המסמך',
    cards: [
      {
        label: 'תעודה',
        title: 'האגודה הלאומית למומחים בפסיכוסומטיקה',
        text: 'תעודה מס׳ 00113, המוצגת באתר כתמונה של המסמך המקורי.',
        image: '/assets/img/certificate-psychosomatics-association.jpeg',
        alt: 'תעודת האגודה הלאומית למומחים בפסיכוסומטיקה מס׳ 00113',
      },
      {
        label: 'השתלמות מקצועית',
        title: 'תעודת השתלמות מקצועית, 120 שעות',
        text: 'המכון הבינלאומי לפסיכולוגיה מעשית, מוסקבה, 2018. הכשרה בעבודה עם פסיכוסומטיקה.',
        image: '/assets/img/certificate-practical-psychology-1600.webp',
        alt: 'תעודת השתלמות מקצועית בהיקף 120 שעות, מוסקבה, 2018',
      },
    ],
    nextHeading: 'מוכנים לבחור זמן?',
    nextText: 'הפגישה הראשונה אונליין עולה 197 ₪. בחרו זמן ביומן או שלחו שאלה ב-WhatsApp.',
    booking: 'בחירת זמן',
    whatsapp: 'שליחת שאלה',
    waMessage: 'שלום דמיטרי, יש לי שאלה לפני קביעת פגישה.',
  },
} as const;
---

<div class="credentials-page" data-credentials-root>
  <header class="credentials-nav">
    <a class="credentials-brand" href="/ru/" data-credentials-home aria-label="DimaTherapy">
      <img src="/assets/icons/logo-d-96.png" alt="" width="36" height="36" />
      <span>DimaTherapy</span>
    </a>
    <div class="credentials-actions">
      <a class="home-link" href="/ru/" data-credentials-home-label>Вернуться на главную</a>
      <div class="language-switch" aria-label="Language">
        <button type="button" data-credentials-lang="ru" data-track="lang_switch" data-track-label="credentials_ru" aria-pressed="true">РУ</button>
        <button type="button" data-credentials-lang="he" data-track="lang_switch" data-track-label="credentials_he" aria-pressed="false">עב</button>
      </div>
    </div>
  </header>

  {Object.entries(copies).map(([key, copy]) => (
    <main data-credentials-copy={key} lang={copy.lang} dir={copy.dir} hidden={key !== 'ru'}>
      <header class="credentials-hero">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="hero-lead">{copy.lead}</p>
      </header>

      <section class="documents" aria-labelledby={`documents-${key}`}>
        <header class="section-heading">
          <h2 id={`documents-${key}`}>{copy.documentsHeading}</h2>
          <p>{copy.documentsLead}</p>
        </header>

        <div class="document-grid">
          {copy.cards.map((card) => (
            <article class="document-card">
              <a class="document-image" href={card.image} target="_blank" rel="noopener">
                <img src={card.image} alt={card.alt} loading="lazy" decoding="async" />
              </a>
              <div class="document-copy">
                <p class="document-label">{card.label}</p>
                <h3>{card.title}</h3>
                <p>{card.text}</p>
                <a class="document-link" href={card.image} target="_blank" rel="noopener" data-track="credential_open">
                  {copy.open}
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="next-step">
        <div>
          <h2>{copy.nextHeading}</h2>
          <p>{copy.nextText}</p>
        </div>
        <div class="next-actions">
          <a class="booking-link" href={key === 'ru' ? '/ru/booking' : '/booking'} data-track="credentials_booking">
            {copy.booking}
          </a>
          <CtaWhatsApp
            label={copy.whatsapp}
            message={copy.waMessage}
            trackLabel={`credentials_${key}`}
            variant="outline"
          />
        </div>
      </section>
    </main>
  ))}
</div>

<script>
  import '../scripts/track';

  const root = document.querySelector<HTMLElement>('[data-credentials-root]');
  const languageButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-credentials-lang]'));
  const copies = Array.from(document.querySelectorAll<HTMLElement>('[data-credentials-copy]'));
  const homeLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-credentials-home]'));
  const homeLabel = document.querySelector<HTMLAnchorElement>('[data-credentials-home-label]');

  const pageState = {
    ru: {
      title: 'Дипломы и сертификаты | Дмитрий Казаков',
      homeHref: '/ru/',
      homeLabel: 'Вернуться на главную',
      dir: 'ltr',
    },
    he: {
      title: 'דיפלומות ותעודות מקצועיות | דמיטרי קזקוב',
      homeHref: '/',
      homeLabel: 'חזרה לעמוד הראשי',
      dir: 'rtl',
    },
  } as const;

  type CredentialsLocale = keyof typeof pageState;

  function setLanguage(locale: CredentialsLocale): void {
    const state = pageState[locale];
    document.documentElement.lang = locale;
    document.documentElement.dir = state.dir;
    document.title = state.title;
    root?.setAttribute('data-active-language', locale);
    copies.forEach((copy) => {
      copy.hidden = copy.dataset.credentialsCopy !== locale;
    });
    languageButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.credentialsLang === locale));
    });
    homeLinks.forEach((link) => {
      link.href = state.homeHref;
    });
    if (homeLabel) {
      homeLabel.href = state.homeHref;
      homeLabel.textContent = state.homeLabel;
    }
    try {
      localStorage.setItem('dmitrySiteLang', locale);
    } catch {
      // La preferencia es opcional; la página funciona aunque storage esté bloqueado.
    }
  }

  languageButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const locale = button.dataset.credentialsLang;
      if (locale === 'ru' || locale === 'he') setLanguage(locale);
    });
  });

  let initial: CredentialsLocale = 'ru';
  const requested = new URLSearchParams(window.location.search).get('lang');
  if (requested === 'he' || requested === 'ru') {
    initial = requested;
  } else {
    const referrer = document.referrer ? new URL(document.referrer) : null;
    if (referrer?.origin === window.location.origin) {
      initial = referrer.pathname.startsWith('/ru/') ? 'ru' : 'he';
    } else {
      try {
        const stored = localStorage.getItem('dmitrySiteLang');
        if (stored === 'he' || stored === 'ru') initial = stored;
      } catch {
        // Se conserva el ruso como idioma inicial si storage está bloqueado.
      }
    }
  }
  setLanguage(initial);
</script>

<style>
  .credentials-page {
    inline-size: min(100% - (var(--page-pad) * 2), var(--content-max));
    margin-inline: auto;
    padding-block-end: var(--sp-10);
  }

  [data-credentials-copy][hidden] {
    display: none;
  }

  .credentials-nav,
  .credentials-brand,
  .credentials-actions,
  .language-switch,
  .next-actions {
    display: flex;
    align-items: center;
  }

  .credentials-nav {
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-4);
    border-block-end: 1px solid var(--color-border);
  }

  .credentials-brand {
    gap: var(--sp-2);
    color: var(--color-text);
    font-weight: var(--fw-semibold);
  }

  .credentials-brand:hover,
  .home-link:hover,
  .booking-link:hover {
    text-decoration: none;
  }

  .credentials-brand img {
    inline-size: 36px;
    block-size: 36px;
  }

  .credentials-actions {
    gap: var(--sp-3);
  }

  .home-link {
    color: var(--color-text-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
  }

  .language-switch {
    gap: var(--sp-1);
    padding: var(--sp-1);
    border: 1px solid var(--color-border);
    border-radius: var(--r-pill);
    background: var(--color-surface);
  }

  .language-switch button {
    min-inline-size: 42px;
    min-block-size: 36px;
    border-radius: var(--r-pill);
    color: var(--color-text-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
  }

  .language-switch button[aria-pressed='true'] {
    color: var(--color-text-on-primary);
    background: var(--color-primary);
  }

  .credentials-hero {
    display: grid;
    gap: var(--sp-3);
    padding-block: var(--sp-10) var(--sp-8);
    max-inline-size: 820px;
  }

  .eyebrow,
  .document-label {
    color: var(--color-primary);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }

  h1 {
    font-size: clamp(var(--fs-xl), 5vw, var(--fs-2xl));
  }

  .hero-lead,
  .section-heading p,
  .document-copy > p:not(.document-label),
  .next-step p {
    color: var(--color-text-2);
  }

  .hero-lead {
    font-size: var(--fs-md);
  }

  .documents {
    display: grid;
    gap: var(--sp-6);
  }

  .section-heading {
    display: grid;
    gap: var(--sp-2);
  }

  .section-heading h2,
  .next-step h2 {
    font-size: var(--fs-xl);
  }

  .document-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-6);
  }

  .document-card {
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--color-surface);
    box-shadow: var(--sh-card);
  }

  .document-image {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-2);
  }

  .document-image img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    padding: var(--sp-4);
  }

  .document-copy {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-6);
  }

  .document-copy h3 {
    font-size: var(--fs-md);
  }

  .document-link {
    inline-size: fit-content;
    font-weight: var(--fw-semibold);
  }

  .next-step {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-6);
    margin-block-start: var(--sp-8);
    padding: var(--sp-7);
    border-radius: var(--r-card);
    background: var(--color-surface);
    box-shadow: var(--sh-card);
  }

  .next-step > div:first-child {
    display: grid;
    gap: var(--sp-2);
    max-inline-size: 620px;
  }

  .next-actions {
    gap: var(--sp-3);
    flex-shrink: 0;
  }

  .booking-link {
    min-block-size: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-3) var(--sp-6);
    border-radius: var(--r-btn);
    color: var(--color-text-on-primary);
    background: var(--color-primary);
    font-weight: var(--fw-semibold);
  }

  .booking-link:hover {
    background: var(--color-primary-hover);
  }

  @media (max-width: 760px) {
    .document-grid {
      grid-template-columns: 1fr;
    }

    .next-step,
    .next-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .next-actions > * {
      inline-size: 100%;
    }
  }

  @media (max-width: 480px) {
    .credentials-brand span,
    .home-link {
      display: none;
    }

    .credentials-hero {
      padding-block-start: var(--sp-8);
    }

    .document-copy,
    .next-step {
      padding: var(--sp-5);
    }
  }
</style>
