---
// Badge.astro — pill pequeña para degreeBadges / approaches / tags sueltos.
interface Props {
  variant?: 'neutral' | 'blue' | 'green';
  class?: string;
}

const { variant = 'neutral', class: className } = Astro.props;
---

<span class:list={['badge', `badge-${variant}`, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-block;
    min-inline-size: 0;
    border-radius: var(--r-pill);
    padding: var(--sp-1) var(--sp-4);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    line-height: var(--lh-normal);
    max-inline-size: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .badge-neutral {
    /* Credenciales largas (degreeBadges): deben poder envolver en varias líneas
       en pantallas angostas. Radio de card, no pill, para que se vean bien
       multi-línea. */
    background: var(--color-surface-2);
    color: var(--color-text-2);
    border-radius: var(--r-btn);
  }

  .badge-blue {
    background: var(--color-primary-100);
    color: var(--color-primary);
  }

  .badge-green {
    background: color-mix(in srgb, var(--color-success) 14%, white);
    color: var(--color-success);
  }
</style>
