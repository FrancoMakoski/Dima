---
// Badge.astro — pill pequeña para degreeBadges / approaches / tags sueltos.
interface Props {
  variant?: 'neutral' | 'blue' | 'green';
  class?: string;
}

const { variant = 'neutral', class: className } = Astro.props;
---

<span class:list={['badge', `badge-${variant}`, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    border-radius: var(--r-pill);
    padding: var(--sp-1) var(--sp-4);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    line-height: var(--lh-normal);
    white-space: nowrap;
  }

  .badge-neutral {
    background: var(--color-surface-2);
    color: var(--color-text-2);
  }

  .badge-blue {
    background: var(--color-primary-100);
    color: var(--color-primary);
  }

  .badge-green {
    background: color-mix(in srgb, var(--color-success) 14%, white);
    color: var(--color-success);
  }
</style>
