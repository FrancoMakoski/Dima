---
// StickyCard.astro — tarjeta lateral (sidebar) estilo Clearly.
// Foto arriba a sangre con overlay + nombre; cuerpo con precio/años, CTA WhatsApp
// primario, botón "beseda" secundario y bloque de próxima disponibilidad.
//
// CONTRATO con el agente de disponibilidad (availability.ts):
//   - [data-availability-block] : contenedor label+chip, empieza `hidden`. El script
//      lo des-oculta (quita `hidden`) cuando tiene un valor real.
//   - [data-next-availability]   : el <span> del chip, VACÍO + `hidden`. El script
//      escribe el texto y lo des-oculta.
//   Si JS no corre, ambos quedan ocultos (no hay fallback con horario inventado).
import Icon from './Icon.astro';
import CtaWhatsApp from './CtaWhatsApp.astro';
import { PROFILE_IMAGE } from '../config/site';
import type { ProfileDict } from '../i18n/types';

interface Props {
  t: ProfileDict['sticky'];
  name: string;
  waMessage: string;
  photoAlt: string;
}

const { t, name, waMessage, photoAlt } = Astro.props;
---

<div class="sticky-card">
  <div class="sc-photo">
    <img
      class="sc-photo-img"
      src={PROFILE_IMAGE}
      alt={photoAlt}
      width="503"
      height="492"
      loading="eager"
      decoding="async"
    />
    <div class="sc-photo-overlay"></div>
    <span class="sc-photo-name">{name}</span>
  </div>

  <div class="sc-body">
    <div class="sc-facts">
      <span class="sc-fact">
        <Icon name="wallet" size={16} class="sc-fact-icon" />
        <span>{t.priceLine}</span>
      </span>
      <span class="sc-fact">
        <Icon name="growth-chart-check" size={16} class="sc-fact-icon" />
        <span>{t.yearsLine}</span>
      </span>
    </div>

    {/* Primario azul → agenda (como Clearly: "Reservar sesión"). */}
    <a
      class="sc-primary"
      href="#schedule"
      data-track="booking_intent"
      data-track-label="sticky_reserve"
    >
      {t.ctaBook}
    </a>

    {/* Secundario outline → WhatsApp con logo (como Clearly: "Contactar"). */}
    <CtaWhatsApp
      label={t.ctaContact}
      message={waMessage}
      trackLabel="sticky_contact"
      variant="outline"
      class="sc-cta"
    />

    <div class="sc-availability" data-availability-block hidden>
      <p class="sc-availability-label">{t.nextAvailabilityLabel}</p>
      <a
        class="sc-availability-chip"
        href="#schedule"
        data-track="booking_intent"
        data-track-label="availability_chip"
        data-next-availability
        hidden
      ></a>
    </div>
  </div>
</div>

<style>
  .sticky-card {
    background: var(--color-surface);
    border-radius: var(--r-card);
    box-shadow: var(--sh-card);
    overflow: hidden;
  }

  /* ---- Foto con overlay + nombre ---- */
  .sc-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .sc-photo-img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .sc-photo-overlay {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 45%;
    background: linear-gradient(
      to top,
      rgba(30, 36, 51, 0.72) 0%,
      rgba(30, 36, 51, 0.32) 45%,
      rgba(30, 36, 51, 0) 100%
    );
    pointer-events: none;
  }

  .sc-photo-name {
    position: absolute;
    inset-inline: var(--sp-4);
    inset-block-end: var(--sp-4);
    text-align: center;
    color: #fff;
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
  }

  /* ---- Cuerpo ---- */
  .sc-body {
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .sc-facts {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .sc-fact {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--color-text-2);
  }

  .sc-fact-icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .sc-cta {
    margin-block-start: var(--sp-1);
  }

  /* Botón primario azul full-width (link a #schedule → agenda). */
  .sc-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 100%;
    margin-block-start: var(--sp-1);
    padding-block: var(--sp-3);
    padding-inline: var(--sp-6);
    border-radius: var(--r-btn);
    border: 1px solid var(--color-primary);
    background: var(--color-primary);
    color: var(--color-text-on-primary);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tight);
    text-align: center;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .sc-primary:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    text-decoration: none;
  }

  /* ---- Bloque próxima disponibilidad (lo llena availability.ts) ---- */
  .sc-availability {
    text-align: center;
    margin-block-start: var(--sp-1);
  }

  .sc-availability[hidden] {
    display: none;
  }

  .sc-availability-label {
    font-size: var(--fs-xs);
    color: var(--color-text-2);
    margin-block-end: var(--sp-2);
  }

  .sc-availability-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--sp-4);
    padding-block: var(--sp-2);
    border-radius: var(--r-pill);
    background: var(--color-primary-100);
    color: var(--color-primary);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tight);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .sc-availability-chip:hover {
    background: color-mix(in srgb, var(--color-primary) 22%, white);
    text-decoration: none;
  }

  .sc-availability-chip:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .sc-availability-chip[hidden] {
    display: none;
  }

  /* Móvil (<960px): la StickyCard entera se oculta — sus CTA viven en
     MobileCtaBar y la disponibilidad/foto ya están en el ProfileHeader compacto. */
  @media (max-width: 960px) {
    .sticky-card {
      display: none;
    }
  }
</style>
