---
// ScheduleCard.astro — "Elige tu horario" (estilo Clearly).
// Server-render: título, nota de zona horaria, contenedor VACÍO que llena el
// script cliente (availability.ts), nota de honestidad, <noscript> de respaldo y
// link discreto al calendario de Google.
//
// CONTRATO: id="schedule" — los CTA "Reservar llamada gratis" de otros componentes
// anclan a #schedule. El script cliente completa [data-next-availability] /
// [data-availability-block] (viven en la StickyCard de otro agente).
//
// El script NO importa el diccionario: le pasamos los strings como JSON en
// data-attributes del contenedor, más el teléfono y el locale.
import Card from './Card.astro';
import Icon from './Icon.astro';
import { PHONE, CALENDAR_URL, PRICE_DISPLAY, waLink } from '../config/site';
import type { ProfileDict, Locale } from '../i18n/types';

interface Props {
  t: ProfileDict['schedule'];
  locale: Locale;
  /** Mensaje wa.me con placeholder {slot} (viene de waMessages.bookSlot). */
  waBookSlotMessage: string;
  /** Nombre del terapeuta para la mini-tarjeta del modal (t.header.name). */
  name: string;
  /** Línea de años de experiencia para la mini-tarjeta del modal (t.header.yearsExp). */
  yearsExp: string;
}

const { t, locale, waBookSlotMessage, name, yearsExp } = Astro.props;

// Strings que el script cliente necesita (serializados a JSON en un data-attr).
const scheduleStrings = {
  sectionLabelDay: t.sectionLabelDay,
  sectionLabelEvening: t.sectionLabelEvening,
  todayLabel: t.todayLabel,
  tomorrowLabel: t.tomorrowLabel,
  slotAriaLabel: t.slotAriaLabel,
  bookSlotMessage: waBookSlotMessage,
  reserveCta: t.reserveCta,
};

// Href inicial del CTA del modal (sin slot): el script lo reescribe con el slot
// elegido al seleccionar un chip. Sirve de fallback si el JS de selección no corre.
const initialWaHref = waLink(waBookSlotMessage.replace('{slot}', ''));
---

<Card title={t.title} icon="clock-badge-peach" id="schedule">
  <p class="sched-tz">
    {t.timezoneNote}
    {/* Hora actual de Israel en vivo, la llena availability.ts: "(GMT+3), 19:53". */}
    <span class="sched-tz-live" data-live-time hidden></span>
  </p>

  <p class="sched-modality">
    <Icon name="info-circle" size={16} class="sched-modality-icon" />
    <span>{t.modalityNote}</span>
  </p>

  <div
    class="sched-mount"
    data-schedule-mount
    data-phone={PHONE}
    data-locale={locale}
    data-strings={JSON.stringify(scheduleStrings)}
  >
    <noscript>
      <p class="sched-noscript">
        {t.noJsFallback}
        {' '}
        <a href={waLink(waBookSlotMessage.replace('{slot}', ''))} target="_blank" rel="noopener">WhatsApp</a>
      </p>
    </noscript>
  </div>

  {/* Resumen del slot elegido + botón de reserva, CENTRADOS (pedido de Franco). */}
  <div class="sched-actions">
    <p class="sched-summary" data-sched-summary hidden></p>

    {/* Botón de reserva: gris/deshabilitado hasta elegir; el script lo habilita,
        le cambia el label a t.reserveCta y abre el modal al hacer click. */}
    <button type="button" class="sched-reserve" data-sched-reserve data-sched-open disabled>
      {t.chooseSlotCta}
    </button>
  </div>

  <p class="sched-honesty">{t.honestyNote}</p>

  <a
    class="sched-calendar-link"
    href={CALENDAR_URL}
    target="_blank"
    rel="noopener"
    data-track="free_call_cta_click"
    data-track-label="schedule_calendar_link"
  >
    <Icon name="checklist-book" size={16} class="sched-calendar-icon" />
    <span>{t.calendarLinkLabel}</span>
  </a>
</Card>

{/* Modal de confirmación de reserva. Mismo patrón que el modal de ReviewsCard:
    header celeste, X, cierre por Esc/backdrop/X, scroll-lock y focus-return. El
    script cliente rellena fecha/hora y el href de WhatsApp con el slot elegido. */}
<dialog class="booking-modal" data-sched-modal aria-labelledby="booking-modal-title">
  <header class="booking-modal-head">
    <h2 class="booking-modal-title" id="booking-modal-title">{t.bookingModalTitle}</h2>
    <button type="button" class="booking-modal-close" data-sched-close aria-label={t.closeLabel}>
      <svg width="20" height="20" aria-hidden="true" viewBox="0 0 24 24">
        <path
          d="M6 6l12 12M18 6L6 18"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </header>

  <div class="booking-modal-body">
    {/* Mini-tarjeta del terapeuta: foto chica + nombre + años (dato honesto). */}
    <div class="booking-therapist">
      <img
        class="booking-therapist-photo"
        src="/assets/img/dmitry-photo2-880.webp"
        alt={name}
        width="48"
        height="48"
        loading="lazy"
        decoding="async"
      />
      <div class="booking-therapist-meta">
        <p class="booking-therapist-name">{name}</p>
        <p class="booking-therapist-years">{yearsExp}</p>
      </div>
    </div>

    {/* Filas label → valor con divisores finos. */}
    <dl class="booking-rows">
      <div class="booking-row">
        <dt class="booking-row-label">{t.dateLabel}</dt>
        <dd class="booking-row-value" data-sched-modal-date></dd>
      </div>
      <div class="booking-row">
        <dt class="booking-row-label">{t.timeLabel}</dt>
        <dd class="booking-row-value" data-sched-modal-time></dd>
      </div>
      <div class="booking-row">
        <dt class="booking-row-label">{t.typeLabel}</dt>
        <dd class="booking-row-value">{t.typeValue}</dd>
      </div>
      <div class="booking-row">
        <dt class="booking-row-label">{t.formatLabel}</dt>
        <dd class="booking-row-value">{t.formatValue}</dd>
      </div>
      <div class="booking-row">
        <dt class="booking-row-label">{t.priceLabel}</dt>
        <dd class="booking-row-value">{PRICE_DISPLAY}</dd>
      </div>
    </dl>

    {/* Declaración del paciente (textos legales del booking de producción):
        el checkbox habilita el CTA de WhatsApp. */}
    <div class="booking-consent" data-sched-consent-box>
      <p class="booking-consent-title">{t.consentTitle}</p>
      <ul class="booking-consent-list">
        {t.consentItems.map((item) => <li>{item}</li>)}
      </ul>
      <label class="booking-consent-check">
        <input type="checkbox" data-sched-consent />
        <span>{t.consentAcceptLabel}</span>
      </label>
    </div>

    {/* CTA primario full-width a WhatsApp; el href se actualiza con el slot.
        Deshabilitado (is-disabled + aria-disabled) hasta aceptar la declaración. */}
    <a
      class="booking-confirm is-disabled"
      aria-disabled="true"
      href={initialWaHref}
      target="_blank"
      rel="noopener"
      data-sched-modal-wa
      data-track="whatsapp_click"
      data-track-label="booking_modal"
      data-conversion-whatsapp
    >
      <Icon name="whatsapp" size={20} class="booking-confirm-icon" />
      <span>{t.confirmWhatsApp}</span>
    </a>

    <p class="booking-honesty">{t.honestyNote}</p>
  </div>
</dialog>

<script>
  import { initSchedule } from '../scripts/availability';

  const mount = document.querySelector<HTMLElement>('[data-schedule-mount]');
  if (mount) {
    const phone = mount.dataset.phone || '';
    const locale = (mount.dataset.locale as 'ru' | 'he') || 'he';
    let strings: Record<string, string> = {};
    try {
      strings = JSON.parse(mount.dataset.strings || '{}');
    } catch {
      strings = {};
    }
    initSchedule({
      container: mount,
      phone,
      locale,
      strings: strings as any,
    });
  }

  // ---- Modal de confirmación de reserva ----
  // Mismo patrón que ReviewsCard: showModal(), cierre por X / Esc / backdrop,
  // scroll-lock del body y devolución del foco al botón que lo abrió.
  const bookingModal = document.querySelector<HTMLDialogElement>('[data-sched-modal]');
  const bookingOpenBtn = document.querySelector<HTMLButtonElement>('[data-sched-open]');
  if (bookingModal && bookingOpenBtn) {
    const bookingCloseBtn = bookingModal.querySelector<HTMLButtonElement>('[data-sched-close]');
    let lastTrigger: HTMLElement | null = null;

    const restoreFocus = () => {
      document.body.style.overflow = '';
      if (lastTrigger && typeof lastTrigger.focus === 'function') lastTrigger.focus();
      lastTrigger = null;
    };

    const openBooking = () => {
      // No abrir si el botón sigue deshabilitado (sin slot elegido).
      if (bookingOpenBtn.disabled) return;
      lastTrigger = bookingOpenBtn;
      document.body.style.overflow = 'hidden';
      if (typeof bookingModal.showModal === 'function') bookingModal.showModal();
      else bookingModal.setAttribute('open', '');
    };

    const closeBooking = () => {
      if (typeof bookingModal.close === 'function') bookingModal.close();
      else bookingModal.removeAttribute('open');
      restoreFocus();
    };

    bookingOpenBtn.addEventListener('click', openBooking);
    if (bookingCloseBtn) bookingCloseBtn.addEventListener('click', closeBooking);

    // Click en backdrop: cae sobre el propio <dialog> (fuera de su contenido).
    bookingModal.addEventListener('click', (e) => {
      if (e.target === bookingModal) closeBooking();
    });

    // Esc del <dialog> nativo dispara 'close' sin pasar por closeBooking().
    bookingModal.addEventListener('close', restoreFocus);

    // ---- Consentimiento: el checkbox habilita el CTA de WhatsApp ----
    const consentCheck = bookingModal.querySelector<HTMLInputElement>('[data-sched-consent]');
    const consentBox = bookingModal.querySelector<HTMLElement>('[data-sched-consent-box]');
    const confirmLink = bookingModal.querySelector<HTMLAnchorElement>('[data-sched-modal-wa]');
    if (consentCheck && confirmLink) {
      const syncConsent = () => {
        const ok = consentCheck.checked;
        confirmLink.classList.toggle('is-disabled', !ok);
        confirmLink.setAttribute('aria-disabled', ok ? 'false' : 'true');
      };
      syncConsent();
      consentCheck.addEventListener('change', syncConsent);
      confirmLink.addEventListener('click', (e) => {
        if (consentCheck.checked) return;
        // Sin consentimiento: no navegar ni disparar tracking de conversión;
        // resaltar la declaración para guiar la vista.
        e.preventDefault();
        e.stopPropagation();
        if (consentBox) {
          consentBox.classList.add('is-attention');
          window.setTimeout(() => consentBox.classList.remove('is-attention'), 1200);
        }
      });
    }
  }
</script>

<style>
  .sched-tz {
    font-size: var(--fs-sm);
    color: var(--color-text-2);
    margin-block-end: var(--sp-3);
  }

  .sched-tz-live {
    font-variant-numeric: tabular-nums;
  }

  .sched-tz-live[hidden] {
    display: none;
  }

  /* "Online, terapia individual" con icono, dentro de la card sobre los chips. */
  .sched-modality {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--color-text-2);
    margin-block-end: var(--sp-4);
  }

  .sched-modality-icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .sched-mount {
    min-block-size: 96px;
  }

  .sched-noscript {
    font-size: var(--fs-sm);
    color: var(--color-text-2);
    line-height: var(--lh-normal);
  }

  .sched-honesty {
    font-size: var(--fs-xs);
    color: var(--color-text-2);
    margin-block-start: var(--sp-4);
    line-height: var(--lh-normal);
  }

  /* ---- Resumen del slot elegido + botón de reserva, al costado (inicio) ---- */
  .sched-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: start;
  }

  .sched-summary {
    margin-block-start: var(--sp-5);
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .sched-summary[hidden] {
    display: none;
  }

  /* Botón de reserva centrado. Deshabilitado = gris;
     habilitado = azul primario. */
  .sched-reserve {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-block-start: var(--sp-4);
    padding-block: var(--sp-3);
    padding-inline: var(--sp-6);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--r-btn);
    background: var(--color-surface-2);
    color: var(--color-text-2);
    font-family: inherit;
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tight);
    cursor: not-allowed;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .sched-reserve:not(:disabled) {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-on-primary);
    cursor: pointer;
  }

  .sched-reserve:not(:disabled):hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  .sched-calendar-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-block-start: var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--color-text-2);
    text-decoration: none;
  }

  .sched-calendar-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .sched-calendar-icon {
    flex-shrink: 0;
  }

  /* ---- Estructura renderizada por el script (selectores globales) ---- */
  .sched-mount :global(.sched-days) {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-block-end: var(--sp-5);
  }

  .sched-mount :global(.sched-days-track) {
    display: flex;
    gap: var(--sp-1);
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    flex: 1;
  }

  .sched-mount :global(.sched-days-track)::-webkit-scrollbar {
    display: none;
  }

  .sched-mount :global(.sched-arrow) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 32px;
    block-size: 32px;
    flex-shrink: 0;
    border-radius: var(--r-pill);
    color: var(--color-text-2);
    background: var(--color-surface-2);
  }

  .sched-mount :global(.sched-arrow):hover {
    color: var(--color-primary);
    background: var(--color-primary-50);
  }

  .sched-mount :global(.sched-day) {
    flex-shrink: 0;
    padding: var(--sp-2) var(--sp-3);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-2);
    border-block-end: 2px solid transparent;
    white-space: nowrap;
    background: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .sched-mount :global(.sched-day.is-active) {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
    border-block-end-color: var(--color-primary);
  }

  .sched-mount :global(.sched-section) {
    margin-block-end: var(--sp-4);
  }

  .sched-mount :global(.sched-section-label) {
    display: block;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-2);
    margin-block-end: var(--sp-2);
  }

  .sched-mount :global(.sched-chips) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  /* Chips ahora son <button>: reset + estado seleccionable. Borde presente
     siempre (transparente) para que la selección no desplace el layout. */
  .sched-mount :global(.sched-chip) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-2) var(--sp-4);
    border: 2px solid transparent;
    border-radius: var(--r-input);
    background: var(--color-primary-100);
    color: var(--color-primary);
    font-family: inherit;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    line-height: var(--lh-tight);
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .sched-mount :global(.sched-chip):hover {
    background: color-mix(in srgb, var(--color-primary) 22%, white);
  }

  /* Seleccionado: fondo blanco, borde azul grueso, texto bold (como Clearly). */
  .sched-mount :global(.sched-chip.is-selected) {
    background: var(--color-surface);
    border-color: var(--color-primary);
    color: var(--color-primary);
    font-weight: var(--fw-bold);
  }

  .sched-mount :global(.sched-chip):focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Móvil: chips táctiles, 2 por fila (grid) y min-height cómoda para el dedo. */
  @media (max-width: 960px) {
    .sched-mount :global(.sched-chips) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-3);
    }

    .sched-mount :global(.sched-chip) {
      justify-content: center;
      min-block-size: 48px;
      font-size: var(--fs-base);
    }
  }

  /* ---- Modal de confirmación de reserva (patrón del modal de ReviewsCard) ---- */
  .booking-modal {
    padding: 0;
    border: none;
    /* Centrar el <dialog>: el reset global `* { margin: 0 }` anula el `margin:auto`
       del user-agent que lo centra, así que hay que restituirlo explícitamente. */
    margin: auto;
    /* Anular el max-width/height físico que el UA impone a <dialog>. */
    max-width: none;
    max-height: none;
    inline-size: min(460px, 92vw);
    max-inline-size: 460px;
    max-block-size: 85vh;
    border-radius: var(--r-card);
    background: var(--color-surface);
    box-shadow: var(--sh-pop);
    overflow: hidden;
  }

  .booking-modal::backdrop {
    background: rgba(15, 18, 28, 0.72);
  }

  .booking-modal-head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-5) var(--sp-6);
    background: var(--color-primary-50);
    border-block-end: 1px solid var(--color-border);
  }

  .booking-modal-title {
    flex: 1;
    min-inline-size: 0;
    margin: 0;
    font-size: var(--fs-lg);
    line-height: var(--lh-tight);
    font-weight: var(--fw-bold);
    color: var(--color-text);
  }

  .booking-modal-close {
    flex-shrink: 0;
    inline-size: 36px;
    block-size: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--color-text-2);
    cursor: pointer;
  }

  .booking-modal-close:hover {
    background: var(--color-primary-100);
    color: var(--color-text);
  }

  .booking-modal-body {
    padding: var(--sp-5) var(--sp-6) var(--sp-6);
    overflow-y: auto;
    max-block-size: calc(85vh - 72px);
    overscroll-behavior: contain;
  }

  /* Mini-tarjeta del terapeuta */
  .booking-therapist {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-block-end: var(--sp-5);
  }

  .booking-therapist-photo {
    flex-shrink: 0;
    inline-size: 48px;
    block-size: 48px;
    border-radius: var(--r-pill);
    object-fit: cover;
    object-position: center top;
  }

  .booking-therapist-name {
    font-weight: var(--fw-bold);
    color: var(--color-text);
    font-size: var(--fs-base);
  }

  .booking-therapist-years {
    font-size: var(--fs-sm);
    color: var(--color-text-2);
  }

  /* Filas label → valor con divisores finos */
  .booking-rows {
    margin: 0 0 var(--sp-5);
  }

  .booking-row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    padding-block: var(--sp-3);
    border-block-end: 1px solid var(--color-border);
  }

  .booking-row:first-child {
    padding-block-start: 0;
  }

  .booking-row:last-child {
    border-block-end: none;
    padding-block-end: 0;
  }

  .booking-row-label {
    flex-shrink: 0;
    font-size: var(--fs-sm);
    color: var(--color-text-2);
  }

  .booking-row-value {
    margin: 0;
    margin-inline-start: auto;
    text-align: end;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  /* ---- Declaración del paciente (consentimiento) ---- */
  .booking-consent {
    margin-block-end: var(--sp-5);
    padding: var(--sp-4);
    border: 1px solid var(--color-border);
    border-radius: var(--r-input);
    background: var(--color-surface-2);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .booking-consent.is-attention {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-100);
  }

  .booking-consent-title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--color-text);
    margin-block-end: var(--sp-3);
  }

  .booking-consent-list {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
    display: grid;
    gap: var(--sp-2);
  }

  .booking-consent-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--color-text-2);
    line-height: var(--lh-normal);
  }

  .booking-consent-list li::before {
    content: '•';
    color: var(--color-primary);
    flex-shrink: 0;
    line-height: var(--lh-normal);
  }

  .booking-consent-check {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    cursor: pointer;
  }

  .booking-consent-check input {
    inline-size: 18px;
    block-size: 18px;
    accent-color: var(--color-primary);
    cursor: pointer;
    flex-shrink: 0;
  }

  /* CTA primario full-width a WhatsApp */
  .booking-confirm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
