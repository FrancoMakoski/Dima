---
// ReviewsCard.astro — "Lo que dicen los clientes". Chips de temas (Badge blue)
// arriba, carrusel scroll-snap de reseñas (avatar-inicial, autor, ubicación,
// Stars al final de línea, texto), flechas prev/next (chevrons del sprite,
// flip-rtl), y nota gris con el total (sin botón fake de "ver todas").
import Card from './Card.astro';
import Badge from './Badge.astro';
import Stars from './Stars.astro';
import type { ProfileDict } from '../i18n/types';

interface Props {
  t: ProfileDict['reviews'];
}

const { t } = Astro.props;

/** Inicial del autor para el avatar (primer carácter significativo). */
const initialOf = (author: string): string => author.trim().charAt(0) || '•';
---

<Card title={t.title} icon="star-rating" class="reviews-card">
  <div class="reviews-topics">
    {t.topics.map((topic) => (
      <Badge variant="blue">{topic}</Badge>
    ))}
  </div>

  <div class="reviews-carousel">
    <button type="button" class="reviews-arrow" data-reviews-prev aria-label="prev">
      <svg width="18" height="18" aria-hidden="true" class="flip-rtl"><use href="/assets/img/profile-icons.svg#chevron-left"></use></svg>
    </button>

    <div class="reviews-track" data-reviews-track>
      {t.items.map((review) => (
        <article class="review">
          <div class="review-head">
            <span class="review-avatar" aria-hidden="true">{initialOf(review.author)}</span>
            <div class="review-meta">
              <p class="review-author">{review.author}</p>
              <p class="review-location">{review.location}</p>
            </div>
            <Stars rating={review.rating} label={`${review.rating} / 5`} />
          </div>
          <p class="review-text">{review.text}</p>
        </article>
      ))}
    </div>

    <button type="button" class="reviews-arrow" data-reviews-next aria-label="next">
      <svg width="18" height="18" aria-hidden="true" class="flip-rtl"><use href="/assets/img/profile-icons.svg#chevron-right"></use></svg>
    </button>
  </div>

  <p class="reviews-all-note">{t.allNote}</p>
</Card>

<script is:inline>
  (() => {
    document.querySelectorAll('.reviews-carousel').forEach((carousel) => {
      const track = carousel.querySelector('[data-reviews-track]');
      const prev = carousel.querySelector('[data-reviews-prev]');
      const next = carousel.querySelector('[data-reviews-next]');
      if (!track || !prev || !next) return;

      const step = () => {
        const first = track.querySelector('.review');
        const gap = 16;
        return first ? first.getBoundingClientRect().width + gap : track.clientWidth * 0.9;
      };

      // scrollBy en el eje inline según dir (en RTL scrollLeft crece hacia el inicio visual).
      const move = (forward) => {
        const rtl = document.dir === 'rtl';
        const dir = forward ? 1 : -1;
        track.scrollBy({ left: dir * (rtl ? -1 : 1) * step(), behavior: 'smooth' });
      };

      prev.addEventListener('click', () => move(false));
      next.addEventListener('click', () => move(true));
    });
  })();
</script>

<style>
  .reviews-topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-block-end: var(--sp-5);
  }

  .reviews-carousel {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .reviews-arrow {
    flex-shrink: 0;
    inline-size: 34px;
    block-size: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-pill);
    color: var(--color-text-2);
    background: var(--color-surface-2);
  }

  .reviews-arrow:hover {
    color: var(--color-primary);
    background: var(--color-primary-50);
  }

  .reviews-track {
    display: flex;
    gap: var(--sp-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    flex: 1;
    min-inline-size: 0;
    scroll-behavior: smooth;
  }

  .reviews-track::-webkit-scrollbar {
    display: none;
  }

  .review {
    flex: 0 0 100%;
    scroll-snap-align: start;
    min-inline-size: 0;
  }

  @media (min-width: 560px) {
    .review {
      flex-basis: calc(50% - var(--sp-2));
    }
  }

  .review-head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-block-end: var(--sp-3);
  }

  .review-avatar {
    flex-shrink: 0;
    inline-size: 40px;
    block-size: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-pill);
    background: var(--color-primary-100);
    color: var(--color-primary);
    font-weight: var(--fw-bold);
    font-size: var(--fs-base);
  }

  .review-meta {
    flex: 1;
    min-inline-size: 0;
  }

  .review-author {
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    font-size: var(--fs-sm);
  }

  .review-location {
    font-size: var(--fs-xs);
    color: var(--color-text-2);
  }

  .review-text {
    color: var(--color-text-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  .reviews-all-note {
    margin-block-start: var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--color-text-2);
    text-align: center;
  }
</style>
