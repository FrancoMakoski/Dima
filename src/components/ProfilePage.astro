---
// ProfilePage.astro — ENSAMBLADOR único de la página de perfil (estilo Clearly).
// Locale-agnóstico total: recibe `locale`, resuelve el dict con getDict, y monta
// todos los componentes en el orden Clearly. La futura página hebrea solo cambia
// la prop `locale` — nada de copy ni de estructura vive acá.
import { getDict } from '../i18n';
import type { Locale } from '../i18n/types';
import { VIDEO_ID } from '../config/site';

import ProfileShell from './ProfileShell.astro';
import TopBar from './TopBar.astro';
import ProfileHeader from './ProfileHeader.astro';
import VideoIntro from './VideoIntro.astro';
import AboutTabs from './AboutTabs.astro';
import QualificationsCard from './QualificationsCard.astro';
import GeneralInfoCard from './GeneralInfoCard.astro';
import ExperienceAccordion from './ExperienceAccordion.astro';
import ScheduleCard from './ScheduleCard.astro';
import ReviewsCard from './ReviewsCard.astro';
import VerifiedBanner from './VerifiedBanner.astro';
import FaqSection from './FaqSection.astro';
import StickyCard from './StickyCard.astro';
import MobileCtaBar from './MobileCtaBar.astro';
import Lightbox from './Lightbox.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<ProfileShell>
  <TopBar slot="topbar" t={t.topbar} locale={locale} />

  {/* Región A (2 columnas): identidad + contenido "sobre el terapeuta".
      Cada sección va envuelta en un `.pm-item pm-<n>`: en móvil los wrappers
      intermedios del Shell colapsan (display:contents) y estos items pasan a ser
      hijos directos del contenedor de página, ordenados por `order` (ver Shell). */}
  <Fragment slot="main">
    <div class="pm-item pm-header"><ProfileHeader t={t.header} /></div>
    <div class="pm-item pm-video"><VideoIntro t={t.video} videoId={VIDEO_ID} /></div>
    <div class="pm-item pm-about"><AboutTabs t={t.about} /></div>
    <div class="pm-item pm-qualifications"><QualificationsCard t={t.qualifications} /></div>
    <div class="pm-item pm-general"><GeneralInfoCard t={t.generalInfo} /></div>
    <div class="pm-item pm-experience"><ExperienceAccordion t={t.experience} /></div>
  </Fragment>

  <StickyCard
    slot="sidebar"
    t={t.sticky}
    name={t.header.name}
    waMessage={t.waMessages.general}
    photoAlt={t.header.name}
  />

  {/* Región B (ancho completo): agenda, prueba social, confianza, FAQ, footer. */}
  <Fragment slot="wide">
    <div class="pm-item pm-schedule"><ScheduleCard t={t.schedule} locale={locale} waBookSlotMessage={t.waMessages.bookSlot} /></div>
    <div class="pm-item pm-reviews"><ReviewsCard t={t.reviews} locale={locale} /></div>
    <div class="pm-item pm-verified"><VerifiedBanner t={t.verified} /></div>
    <div class="pm-item pm-faq"><FaqSection t={t.faq} /></div>

    <footer class="profile-footer pm-footer">
      <nav class="profile-footer-nav" aria-label={t.footer.nav.heading}>
        <h2 class="profile-footer-heading">{t.footer.nav.heading}</h2>
        <ul class="profile-footer-links">
          {t.footer.nav.links.map((link) => (
            <li>
              <a href={link.href} class="profile-footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="profile-footer-line">{t.footer.line}</p>
    </footer>
  </Fragment>

  <Fragment slot="after">
    <MobileCtaBar t={t.mobileBar} waMessage={t.waMessages.general} />
    <Lightbox />
  </Fragment>
</ProfileShell>

<script>
  import '../scripts/track';
</script>

<style>
  /* ---- Wrappers de sección para el reorden móvil ----
     Desktop: transparentes al layout (display:contents) → las secciones reales
     (Cards) siguen siendo hijas directas de .shell-main / .shell-wide y conservan
     el gap del flex column. Móvil: se vuelven items reales del flex de .shell
     (ver ProfileShell) y se ordenan con `order` en el orden Clearly. */
  .pm-item {
    display: contents;
  }

  @media (max-width: 960px) {
    .pm-item {
      display: block;
    }

    .pm-header { order: 1; }
    .pm-video { order: 2; }
    .pm-about { order: 3; }
    .pm-qualifications { order: 4; }
    .pm-schedule { order: 5; }
    .pm-reviews { order: 6; }
    .pm-general { order: 7; }
    .pm-experience { order: 8; }
    .pm-verified { order: 9; }
    .pm-faq { order: 10; }
    .pm-footer { order: 11; }
  }

  .profile-footer {
    padding-block: var(--sp-8) var(--sp-6);
    border-block-start: 1px solid var(--color-border);
    text-align: center;
  }

  .profile-footer-nav {
    margin-block-end: var(--sp-5);
  }

  .profile-footer-heading {
    margin-block-end: var(--sp-3);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-2);
  }

  .profile-footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-2) var(--sp-5);
  }

  .profile-footer-line {
    font-size: var(--fs-xs);
    color: var(--color-text-2);
  }

  .profile-footer-link {
    font-size: var(--fs-sm);
    color: var(--color-text-2);
    text-decoration: none;
  }

  .profile-footer-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
