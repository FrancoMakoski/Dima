---
// ProfilePage.astro — ENSAMBLADOR único de la página de perfil (estilo Clearly).
// Locale-agnóstico total: recibe `locale`, resuelve el dict con getDict, y monta
// todos los componentes en el orden Clearly. La futura página hebrea solo cambia
// la prop `locale` — nada de copy ni de estructura vive acá.
import { getDict } from '../i18n';
import type { Locale } from '../i18n/types';
import { VIDEO_ID } from '../config/site';

import ProfileShell from './ProfileShell.astro';
import TopBar from './TopBar.astro';
import ProfileHeader from './ProfileHeader.astro';
import VideoIntro from './VideoIntro.astro';
import AboutTabs from './AboutTabs.astro';
import QualificationsCard from './QualificationsCard.astro';
import GeneralInfoCard from './GeneralInfoCard.astro';
import ExperienceAccordion from './ExperienceAccordion.astro';
import ScheduleCard from './ScheduleCard.astro';
import ReviewsCard from './ReviewsCard.astro';
import VerifiedBanner from './VerifiedBanner.astro';
import FaqSection from './FaqSection.astro';
import StickyCard from './StickyCard.astro';
import MobileCtaBar from './MobileCtaBar.astro';
import Lightbox from './Lightbox.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<ProfileShell>
  <TopBar slot="topbar" t={t.topbar} locale={locale} />

  {/* Región A (2 columnas): identidad + contenido "sobre el terapeuta". */}
  <Fragment slot="main">
    <ProfileHeader t={t.header} />
    <VideoIntro t={t.video} videoId={VIDEO_ID} />
    <AboutTabs t={t.about} />
    <QualificationsCard t={t.qualifications} />
    <GeneralInfoCard t={t.generalInfo} />
    <ExperienceAccordion t={t.experience} />
  </Fragment>

  <StickyCard
    slot="sidebar"
    t={t.sticky}
    name={t.header.name}
    waMessage={t.waMessages.general}
    photoAlt={t.header.name}
  />

  {/* Región B (ancho completo): agenda, prueba social, confianza, FAQ, footer. */}
  <Fragment slot="wide">
    <ScheduleCard t={t.schedule} locale={locale} waBookSlotMessage={t.waMessages.bookSlot} />
    <ReviewsCard t={t.reviews} locale={locale} />
    <VerifiedBanner t={t.verified} />
    <FaqSection t={t.faq} />

    <footer class="profile-footer">
      <nav class="profile-footer-nav" aria-label={t.footer.nav.heading}>
        <h2 class="profile-footer-heading">{t.footer.nav.heading}</h2>
        <ul class="profile-footer-links">
          {t.footer.nav.links.map((link) => (
            <li>
              <a href={link.href} class="profile-footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="profile-footer-line">{t.footer.line}</p>
    </footer>
  </Fragment>

  <Fragment slot="after">
    <MobileCtaBar t={t.mobileBar} waMessage={t.waMessages.general} />
    <Lightbox />
  </Fragment>
</ProfileShell>

<script>
  import '../scripts/track';
</script>

<style>
  .profile-footer {
    padding-block: var(--sp-8) var(--sp-6);
    border-block-start: 1px solid var(--color-border);
    text-align: center;
  }

  .profile-footer-nav {
    margin-block-end: var(--sp-5);
  }

  .profile-footer-heading {
    margin-block-end: var(--sp-3);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-2);
  }

  .profile-footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-2) var(--sp-5);
  }

  .profile-footer-line {
    font-size: var(--fs-xs);
    color: var(--color-text-2);
  }

  .profile-footer-link {
    font-size: var(--fs-sm);
    color: var(--color-text-2);
    text-decoration: none;
  }

  .profile-footer-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
